# Copy this file to app/server/.env (git-ignored) and fill it in.

# Create a key at https://ollama.com/settings/keys. Without one the server falls back to an offline mock model.
OLLAMA_API_KEY=

# Cloud model tag as used by the direct API (no "-cloud" suffix). Full list: https://ollama.com/api/tags
OLLAMA_MODEL=gemma4:31b

# AWS Bedrock as a backup model (switch to it with the Backup button in the demos). Use ONE of:
#   a Bedrock API key (console > Bedrock > API keys), or an AWS access key pair (+ session token if temporary).
AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# A model id or inference profile id. Default is Amazon's own Nova 2 Lite (no marketplace subscription needed).
# Claude Haiku 5.5 would be: global.anthropic.claude-haiku-5-5
BEDROCK_MODEL=global.amazon.nova-2-lite-v1:0

# Real web search for the routing demo (https://api-dashboard.search.brave.com). Without a key the demo shows invented results.
BRAVE_API_KEY=

# Which model to start with: ollama, bedrock or mock (offline). Default: the first one that is set up.
# LLM_PROVIDER=ollama

# The first and last slides. Everything here is optional; anything left empty is simply not shown.
# Your name as the presenter (shown as "Presented by <name>" on the title slide).
PRESENTER_NAME=
# The team's name, and its members' names separated by commas (up to 10; the layout is made for 7).
TEAM_NAME=
TEAM_MEMBERS=
# A logo for the corner of the first and last slides: the path of a PNG, JPG, SVG, GIF or WebP file (max 5 MB) on this
# machine. An absolute path is safest; a relative one starts from the app/ folder.
LOGO_PATH=

# Backend listens on localhost only; the Vite dev/preview server proxies /api to it.
PORT=8787
