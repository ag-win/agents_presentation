# Copy this file to app/server/.env (git-ignored) and fill it in.

# Create a key at https://ollama.com/settings/keys. Without one the server falls back to an offline mock model.
OLLAMA_API_KEY=

# Cloud model tag as used by the direct API (no "-cloud" suffix). Full list: https://ollama.com/api/tags
OLLAMA_MODEL=gemma4:31b

# Force the offline mock model even if a key is set.
# LLM_PROVIDER=mock

# Backend listens on localhost only; the Vite dev/preview server proxies /api to it.
PORT=8787
